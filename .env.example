# ─────────────────────────────────────────────
# CS-LearnMate 环境变量（复制为 .env.local 使用）
# 不配置密钥也可运行：系统自动进入本地演示模式
# ─────────────────────────────────────────────

# 账号与个人模型加密
# 生产环境必须设置，且保持稳定；否则会在 .data/ 下自动生成随机密钥文件，
# Serverless 多实例部署时会因密钥不一致导致登录态失效。
AUTH_SECRET=
MODEL_SECRET=

# 服务端默认大模型（OpenAI 兼容协议，可选）
# 用户未配置个人模型时使用；两者都为空则进入本地演示模式。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 可选：OpenAI 兼容的 Embedding 服务（默认使用内置本地向量引擎）
# 示例：SiliconFlow / Ollama / 自建 OpenAI 兼容网关
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 检索与存储
RAG_TOP_K=5
RAG_MIN_SCORE=0.08
DATA_DIR=.data

# 可选：单文件大小上限（MB）
MAX_UPLOAD_MB=20

# 可选：图片 OCR 语言（Tesseract），默认中英文
# 首次识别会把语言包复制到 .data/ocr-lang 并缓存在 .data/ocr-cache
OCR_LANGS=chi_sim+eng
